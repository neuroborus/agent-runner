{
  "name": "agent-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Local CLI and STDIO MCP server for durable agent pipelines",
  "type": "module",
  "exports": "./src/index.js",
  "workspaces": [
    "packages/*",
    "pipelines/*"
  ],
  "bin": {
    "agent-run": "./bin/agent-run.js"
  },
  "scripts": {
    "check": "npm run format:check && npm test && node bin/agent-run.js --help",
    "format": "node scripts/format.js --write",
    "format:check": "node scripts/format.js --check",
    "test": "node --test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@agent-runner/plan-authoring": "0.0.0",
    "@agent-runner/plan-execution": "0.0.0",
    "@agent-runner/polishing": "0.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "prettier": "3.9.6"
  }
}
