{
  "schemaVersion": 1,
  "artifactRoot": "LOCAL_ARTIFACTS",
  "issueReporting": true,
  "defaultBackend": "codex",
  "defaultProfile": "current",
  "defaultModel": "current",
  "defaultEffort": "current",
  "defaultContextSize": "current",
  "trustedCommands": {
    "repository-check": {
      "command": "npm run check",
      "executable": "npm",
      "arguments": ["run", "check"],
      "capabilities": { "scratch": true, "cache": true }
    }
  },
  "profiles": {
    "codex-work": {
      "backend": "codex",
      "profile": "work"
    },
    "claude-primary": {
      "backend": "claude",
      "configDirectory": "/profiles/claude-primary"
    },
    "claude-secondary": {
      "backend": "claude",
      "configDirectory": "/profiles/claude-secondary"
    }
  },
  "pipelines": {
    "plan-authoring": {
      "mode": "independent",
      "maxRevisionRounds": 20,
      "preferredCommitLineLimit": 900,
      "stagnationWindowRounds": 3,
      "roles": {
        "planner": {},
        "reviewer": {
          "backend": "claude",
          "profile": "claude-primary",
          "model": "sonnet"
        },
        "arbiter": {}
      }
    },
    "plan-execution": {
      "mode": "independent",
      "finalization": "auto",
      "maxFixRoundsPerStep": 20,
      "maxDisputesPerFinding": 5,
      "maxSameFindingRounds": 5,
      "stagnationWindowRounds": 3,
      "trustedChecks": ["repository-check"],
      "roles": {
        "worker": {},
        "reviewer": {
          "backend": "claude",
          "profile": "claude-primary",
          "model": "current",
          "contextSize": "current",
          "effort": "current"
        },
        "arbiter": {}
      }
    },
    "polishing": {
      "mode": "independent",
      "finalization": "auto",
      "maxFixRounds": 20,
      "maxDisputesPerFinding": 5,
      "maxSameFindingRounds": 5,
      "stagnationWindowRounds": 3,
      "trustedChecks": ["repository-check"],
      "roles": {
        "worker": {},
        "reviewer": {
          "backend": "claude",
          "profile": "claude-primary",
          "model": "current",
          "contextSize": "current",
          "effort": "current"
        },
        "arbiter": {}
      }
    }
  }
}
