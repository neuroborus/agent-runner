{
  "name": "agent-runner",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "agent-runner",
      "version": "0.0.0",
      "workspaces": [
        "packages/*",
        "pipelines/*"
      ],
      "dependencies": {
        "@agent-runner/plan-authoring": "0.0.0",
        "@agent-runner/plan-execution": "0.0.0"
      },
      "bin": {
        "agent-run": "bin/agent-run.js"
      },
      "engines": {
        "node": ">=24 <25"
      }
    },
    "node_modules/@agent-runner/commit-plan": {
      "resolved": "packages/commit-plan",
      "link": true
    },
    "node_modules/@agent-runner/plan-authoring": {
      "resolved": "pipelines/plan-authoring",
      "link": true
    },
    "node_modules/@agent-runner/plan-execution": {
      "resolved": "pipelines/plan-execution",
      "link": true
    },
    "packages/commit-plan": {
      "name": "@agent-runner/commit-plan",
      "version": "0.0.0",
      "engines": {
        "node": ">=24 <25"
      }
    },
    "pipelines/plan-authoring": {
      "name": "@agent-runner/plan-authoring",
      "version": "0.0.0",
      "engines": {
        "node": ">=24 <25"
      }
    },
    "pipelines/plan-execution": {
      "name": "@agent-runner/plan-execution",
      "version": "0.0.0",
      "engines": {
        "node": ">=24 <25"
      }
    }
  }
}
